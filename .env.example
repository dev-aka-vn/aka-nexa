# aka-nexa — the boot contract, in one place (UAT gap G1).
#
# This file is a REFERENCE, not a loader target. `ConfigModule` validates
# `process.env` and nothing in this repository reads a `.env` file
# (packages/platform/src/config/config.module.ts builds its ConfigService in a
# useFactory over the live environment). To adopt these values in a shell:
#
#   set -a; . ./.env.example; set +a
#
# Every line below that is not a comment is a real assignment, so the file is a
# command a reader can run rather than documentation they have to transcribe.
# Comments go on their own lines above the key they describe, because a trailing
# comment would be part of the value.
#
# This file is committed, so it holds no secret: `CRYPTO_LOCAL_KEY_FILE` is a
# path, never a key value.


# Required, and deliberately without a default. A process that never declared
# its environment must not inherit developer behaviour (CR-01). Absent, boot
# fails with `CONFIG_INVALID: NODE_ENV` before a single module resolves.
NODE_ENV=development

# Required. Where the platform stores its data.
# `compose.dev.yml` publishes MongoDB on 127.0.0.1:27017, so this URL is correct
# against the local stack with nothing to edit.
#
# No `?directConnection=true` here, and it must stay absent: that parameter
# compensates for a MongoDB started with `--replSet`, which advertises its
# container hostname as the replica-set member and leaves the driver resolving an
# unresolvable name. `compose.dev.yml` deliberately runs without `--replSet`, so
# the documented stack needs no compensation. See the Mongo trap in README.md.
MONGO_URL=mongodb://127.0.0.1:27017/akane

# Required, and required to be TWO DIFFERENT INSTANCES (D-12).
# `maxmemory-policy` is instance-wide, so a logical-database suffix (/0 vs /1)
# cannot express the split: the cache tier must be evicting and the queue tier
# must never evict. `compose.dev.yml` publishes redis-cache on 6379 and
# redis-queue on 6380, which is why these two host:port values differ. Collapsing
# them to one instance fails boot with `CONFIG_INVALID: REDIS_INSTANCES_NOT_DISTINCT`.
REDIS_CACHE_URL=redis://127.0.0.1:6379

# The second half of the D-12 split. BullMQ requires `noeviction` on this tier,
# so a full memory limit surfaces as a write error instead of a silently
# discarded queued job.
REDIS_QUEUE_URL=redis://127.0.0.1:6380

# `local` or `kms`.
#
# DEVELOPMENT ONLY. `local` reads a plaintext key from disk, and a production
# boot selecting it is refused with `CRYPTO_KEY_PROVIDER_REQUIRED:` before any
# key file is opened. `kms` is currently refused too, with `KMS_PROVIDER_BLOCKED:`,
# until a deployment cloud is named (D-27 / blocker B-3) — so today every boot
# needs the local key file, and a production deployment cannot proceed until B-3
# is resolved. That is the guard working, not a gap to route around.
CRYPTO_KEY_PROVIDER=local

# Required whenever `CRYPTO_KEY_PROVIDER=local` is selected: a path to a file
# holding exactly 32 raw bytes of key material. Provision it once per checkout:
#
#   head -c 32 /dev/urandom > .dev-local-key
#
# The path, never the key — a key in an environment variable is a key in the
# process table, in the crash dump, and in every CI log that echoes its
# environment. `.dev-local-key` is in `.gitignore`, so following this recipe
# cannot commit a plaintext key. The file is absent on a fresh checkout, and a
# boot that finds it missing fails with `LOCAL_KEY_FILE_MISSING:`.
CRYPTO_LOCAL_KEY_FILE=./.dev-local-key

# Required, and deliberately NOT active in this file.
#
# `SERVICE_NAME` has no default on purpose: it is the only value in the
# environment that identifies which of the three processes this is, and it is
# what derives the default port. Each run command sets it inline — see README.md
# for `start:api`, `start:worker` and `start:scheduler`.
#
# Leaving it inactive here is what makes a mistake loud. Boot the file as written
# and the process aborts with `CONFIG_INVALID: SERVICE_NAME`; default it to `api`
# instead and a reader who starts a second process silently contends for the
# api's port 3000 and reads the wrong process's health endpoint.
#
#   SERVICE_NAME=api

# Optional. Defaults per `SERVICE_NAME`: api 3000, worker 3001, scheduler 3002.
# Set it only to move one process off its default — which is the documented
# remedy when that port is already taken (see the port trap in README.md).
#
#   PORT=3000

# Optional. Base OTLP/HTTP collector endpoint, e.g. `http://127.0.0.1:4318`.
# Absent is legal: telemetry failing to export must never be the reason a process
# refuses to start. Malformed is not — a typo'd endpoint that silently exports
# nothing fails boot with `CONFIG_INVALID: OTEL_EXPORTER_OTLP_ENDPOINT`.
#
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318