{
  "title": "Platform Health",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active Users (IM connections)",
      "targets": [{ "expr": "im_active_connections", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Submissions per minute",
      "targets": [{ "expr": "sum(rate(submission_status[1m])) * 60", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Queue depth",
      "targets": [{ "expr": "queue_depth", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Oldest queue item age",
      "targets": [{ "expr": "queue_oldest_item_age", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Read-link denials",
      "targets": [{ "expr": "read_link_denials_total", "refId": "A" }]
    }
  ]
}
